{
  "name": "pokefirered-lab-harness",
  "private": true,
  "type": "module",
  "scripts": {
    "viewer": "bun run src/server.ts",
    "bot": "bun run src/harness/play.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --error-on-warnings",
    "knip": "knip",
    "test": "bun test",
    "prepare": "cd .. && husky lab/.husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.4.4",
    "husky": "9.1.7",
    "knip": "6.43.0",
    "lint-staged": "17.6.0",
    "typescript": "7.0.2"
  },
  "knip": {
    "entry": ["viewer/viewer.ts", "bots/*.ts"],
    "project": ["src/**/*.ts", "viewer/**/*.ts", "bots/**/*.ts"]
  },
  "lint-staged": {
    "*.{ts,json,html}": "biome lint --error-on-warnings --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
