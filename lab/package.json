{
  "name": "pokefirered-lab-harness",
  "private": true,
  "type": "module",
  "scripts": {
    "viewer": "bun run src/server.ts",
    "bot": "bun run src/harness/play.ts",
    "migrate": "bun run src/harness/migrate.ts",
    "race": "bun run src/race/make.ts",
    "evolve": "bun run src/genetic/evolve.ts",
    "learn-lab": "bun run src/model/learn-lab.ts",
    "battle-lab": "bun run src/model/battle-lab.ts",
    "map-lab": "bun run src/model/map-lab.ts",
    "shot": "bun run src/tools/shot.ts",
    "map": "bun run src/tools/map.ts",
    "arena-font": "bun run src/tools/arena-font.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --error-on-warnings",
    "knip": "knip",
    "test": "bun test --parallel",
    "rules": "bun run src/checks/diff-rules.ts",
    "check": "bun run lint && bun run knip && bun run typecheck && bun run rules",
    "prepare": "cd .. && husky lab/.husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@openai/codex": "0.171.0",
    "@types/bun": "1.4.5",
    "husky": "9.1.7",
    "knip": "6.48.0",
    "lint-staged": "17.6.2",
    "typescript": "7.0.2"
  },
  "knip": {
    "entry": ["viewer/viewer.ts", "bots/*.ts"],
    "project": ["src/**/*.ts", "viewer/**/*.{ts,tsx}", "bots/**/*.ts"],
    "ignoreDependencies": ["@fontsource/*", "@openai/codex", "bun-plugin-tailwind", "tailwindcss"]
  },
  "lint-staged": {
    "*.{ts,tsx,json,html,css}": "biome lint --error-on-warnings --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/raleway": "5.3.0",
    "bun-plugin-tailwind": "0.1.2",
    "lucide-preact": "1.78.0",
    "preact": "11.2.0",
    "tailwindcss": "4.3.5"
  }
}
