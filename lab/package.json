{
  "name": "pokefirered-lab-harness",
  "private": true,
  "type": "module",
  "scripts": {
    "viewer": "bun run src/server.ts",
    "bot": "bun run src/harness/play.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --error-on-warnings",
    "knip": "knip",
    "test": "bun test",
    "prepare": "cd .. && husky lab/.husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.4.4",
    "husky": "9.1.7",
    "knip": "6.43.0",
    "lint-staged": "17.6.0",
    "typescript": "7.0.2"
  },
  "knip": {
    "entry": ["viewer/viewer.ts", "bots/*.ts"],
    "project": ["src/**/*.ts", "viewer/**/*.{ts,tsx}", "bots/**/*.ts"],
    "ignoreDependencies": ["@fontsource/*", "bun-plugin-tailwind", "tailwindcss"]
  },
  "lint-staged": {
    "*.{ts,tsx,json,html,css}": "biome lint --error-on-warnings --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/raleway": "5.3.0",
    "bun-plugin-tailwind": "0.1.2",
    "lucide-preact": "1.62.0",
    "preact": "11.1.0",
    "tailwindcss": "4.3.3"
  }
}
